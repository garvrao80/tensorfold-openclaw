{
  "id": "tensorfold",
  "name": "TensorFold",
  "description": "Local model discovery, inference, and server telemetry",
  "categories": ["models"],
  "providers": ["tensorfold"],
  "activation": { "onStartup": true },
  "modelCatalog": { "discovery": { "tensorfold": "refreshable" } },
  "modelPricing": { "providers": { "tensorfold": { "external": false } } },
  "setup": {
    "providers": [{ "id": "tensorfold", "envVars": ["TENSORFOLD_API_KEY"] }]
  },
  "providerRequest": {
    "providers": {
      "tensorfold": {
        "family": "tensorfold",
        "openAICompletions": { "supportsStreamingUsage": true }
      }
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/index.js",
    "styles": ["dist/control-ui/index.css"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string", "default": "http://127.0.0.1:8080/v1" },
      "timeoutMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 30000,
        "default": 5000
      },
      "fallbackContextWindow": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 1048576,
        "default": 8192
      },
      "nativeToolChoice": { "type": "boolean", "default": false }
    }
  }
}
